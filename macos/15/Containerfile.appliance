# A bootable macOS 15 machine - and you choose which disk it boots.
#
#     docker build -f macos/15/Containerfile.appliance -t easydiskbake:macos15-appliance .
#
#     # Recovery, with no disk attached
#     docker run --rm -it --device /dev/kvm --device /dev/net/tun --cap-add NET_ADMIN \
#         -p 6080:6080 -v macos15-data:/data easydiskbake:macos15-appliance
#
#     # the installer, the Setup Assistant, or a finished machine with Remote Login on
#     docker run ... easydiskbake:macos15-appliance --disk setup
#     docker run ... easydiskbake:macos15-appliance --disk desktop
#     docker run ... easydiskbake:macos15-appliance --disk ssh
#
#     http://localhost:6080/vnc.html        the guest's screen
#     ssh -p 2222 docker@localhost          password: admin   (only with --disk ssh)
#
# WHY THE DISK IS NOT IN THE IMAGE
#
# The first version baked macos15-ssh in. That produced a 16 GiB image that could boot exactly
# one thing and answered a question nobody had asked. The disks people actually want are three
# different stages, and all three are already published:
#
#     macos15-setup     the installer: Recovery, Disk Utility, the whole walk from the start
#     macos15-desktop   an install that finished and stopped at the Setup Assistant
#     macos15-ssh       a finished machine, Remote Login already on
#
# So the image carries the BOOT ENVIRONMENT - Apple's recovery image, OpenCore, the firmware and
# the OpenCore template - and the disk arrives when the container is asked for one, pulled once
# onto the volume it is given. No flag at all means NO DISK, which is how you get to Recovery.
#
# WHAT THAT COSTS AND WHAT IT BUYS
#
#     this image       ~900 MiB, builds in seconds, boots four different things
#     the old one     16 GiB, built in a quarter of an hour, booted one
#
# A first start with a disk downloads it (16 GiB for the ssh disk). That is the trade: an image
# that is cheap to build and pull, and a disk that is paid for once per volume rather than once
# per image - and a volume is the thing you were going to keep anyway, because it is where the
# guest's writes go.
#
# A START WITH NO NETWORK STILL BOOTS. The recovery image and the four OpenCore assets are the
# only inputs a first start cannot fetch, and both are inside the image.
#
# WHY THE BAKE IMAGE IS THE BASE AND NOT A BARE DEBIAN
#
# The tooling is already there, pinned, and checked by the root Containerfile's build-time
# self-test: qemu 11.1 with KVM, 7z (the OpenCore template is an ISO9660 image with a Joliet
# name table), mtools (mformat/mcopy build the 200 MiB ESP), unzip, aria2, python3. Re-deriving
# that list here is the mistake the root Containerfile documents at length under sshpass - one
# fact in two places drifts.
#
# WHAT IS ADDED: websockify, because this image serves a screen to a browser and the bake image
# only ever wrote a VNC stream to a file.
#
# BUILD IT WITH SECRETS, NOT ARGS. a `docker build --build-arg GITHUB_TOKEN=...` bakes the
# token into the image history; `--secret` does not. The build pulls the recovery image and the
# four pinned assets from this repository's own ghcr package, through lib/iso.py.

# ---------------------------------------------------------------------------
# stage 1: fetch the boot environment. This stage has the token; the image does not.
# ---------------------------------------------------------------------------
FROM ghcr.io/easydev-org/easydiskbake:latest AS assets

# /repo DOES NOT EXIST IN THE BASE IMAGE, and that is worth saying because the RUN below reads
# from it. Every bake gets /repo from `actions/checkout` at run time; a `docker build` gets it
# from here. Only the half appliance.py imports is copied.
COPY lib /repo/lib
COPY macos/15 /repo/macos/15

RUN --mount=type=secret,id=ghcr_token \
    set -eux; \
    if [ -f /run/secrets/ghcr_token ]; then \
        ISO_USER="${GITHUB_ACTOR:-SilverMelon233}"; \
        export ISO_USER; \
        export ISO_PASSWORD="$(cat /run/secrets/ghcr_token)"; \
    fi; \
    export REPO=/repo; \
    cd /repo; \
    python3 macos/15/appliance.py fetch --out /assets

# THE SELF-CHECK IS ON THE BYTES, NOT ON THE DOCKERFILE.
#
# It re-reads every asset and confirms the four pinned ones carry the sha256 in lib/images.py. A
# build that quietly copied a stale recovery image fails here - in seconds - instead of on the
# user's machine as a guest that stops at a prohibited sign.
RUN set -eux; \
    export REPO=/repo; \
    cd /repo; \
    python3 macos/15/appliance.py check --assets /assets; \
    du -sh /assets; \
    ls -l /assets /assets/opencore

# ---------------------------------------------------------------------------
# stage 2: the appliance.
# ---------------------------------------------------------------------------
FROM ghcr.io/easydev-org/easydiskbake:latest

# websockify serves the noVNC page and bridges it to qemu's VNC port. The base image already
# carries /usr/share/novnc; websockify is the one package this image adds.
#
# --break-system-packages is not needed because this is the distro package rather than pip on a
# PEP 668 managed environment.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3-websockify \
        ; \
    rm -rf /var/lib/apt/lists/*

# THE ENTRY POINT IS EXPECTED TO BE EMPTY - the root Containerfile clears it because GitHub
# Actions runs a container job as `docker run <image> <command>` and the qemux base's entrypoint
# starts a VM. That is exactly what THIS image wants back.
#
# ONE COPY PER FILE, AND IT MATTERS LESS THAN IT DID. These are six files totalling ~870 MiB, and
# the largest is the 847 MiB recovery image - comfortably under the documented 10 GB per-layer
# ceiling, so a single COPY would work. They are separate anyway because each one is a distinct
# asset with its own reason to exist, and a reader looking for "where does the APFS driver come
# from" should find `recovery.dmg` on a line of its own.
COPY --from=assets /assets/recovery.dmg /assets/recovery.dmg
COPY --from=assets /assets/opencore/opencore.zip /assets/opencore/opencore.zip
COPY --from=assets /assets/opencore/opencore-template.iso /assets/opencore/opencore-template.iso
COPY --from=assets /assets/opencore/macos.rom /assets/opencore/macos.rom
COPY --from=assets /assets/opencore/OVMF_VARS-1920x1080.fd /assets/opencore/OVMF_VARS-1920x1080.fd

# /ASSETS IS READ-ONLY AT RUN TIME. It is the boot environment; a start that could write there
# would be a start whose second boot differs from its first. The image is read-only anyway - this
# states the intent where a reader will look for it.
RUN set -eux; \
    test -f /assets/recovery.dmg; \
    test -f /assets/opencore/macos.rom; \
    mkdir -p /data /repo; \
    chmod 0755 /assets /assets/opencore

COPY lib /repo/lib
COPY macos/15 /repo/macos/15

ENV REPO=/repo \
    ASSETS=/assets \
    DATA=/data \
    VM_DISK=none \
    VM_MEM=8192 \
    VM_CPUS=4 \
    VM_SSH_PORT=2222 \
    VM_RDP_PORT=3389 \
    VM_NOVNC_PORT=6080

# THE VOLUME IS THE GUEST'S DISK AND THE DOWNLOADED BASE. Named, it survives `docker rm`, so a
# second start with the same --disk boots the same bytes without pulling 16 GiB again.
VOLUME ["/data"]

EXPOSE 6080 5900 2222 3389

# A START WITH NO KVM MUST FAIL, NOT DEGRADE. The entry point checks /dev/kvm before anything
# else and lib/vm.py passes -enable-kvm unconditionally; there is no TCG path to fall back to.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f qemu-system-x86_64 >/dev/null || exit 1

# qemu IS PID 1. The entry point execs it, so a signal sent to the container reaches the guest
# and there is no supervisor process to keep alive. See macos/15/appliance_run.py.
#
# ARGUMENTS PASS THROUGH: `docker run <image> --disk ssh` reaches the entry point as
# `--disk ssh`, which is why the choice is a flag and not an environment variable nobody can
# find. VM_DISK is the same choice for a compose file.
ENTRYPOINT ["python3", "/repo/macos/15/appliance_run.py"]
CMD []
